# Private server configuration. Copy this file to .env for local development.
# Create a free key at https://developer.clashofclans.com.
# Allow 45.79.218.79 for the fixed-IP RoyaleAPI proxy used below.
# Configure COC_API_TOKEN as a secret in Sites for the hosted deployment.
COC_API_TOKEN=
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Vercel only: remote libSQL storage and a separate production admin credential.
# See VERCEL.md. Generate the hash and cron secret with npm run admin:setup:vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RAIDROOM_ADMIN_PASSWORD_HASH=
CRON_SECRET=
# Default on Vercel is 86400 (daily). Set 60 only after configuring a minute scheduler.
# RAIDROOM_SYNC_INTERVAL_SECONDS=60

# Local admin login: run npm run admin:setup. It creates a private access note
# and adds a generated verifier to your ignored .env. Never deploy those values.
# Hosted admins use the existing Sites sign-in with explicit user IDs instead.
RAIDROOM_AUTH_HOST=
RAIDROOM_ADMIN_USER_IDS=

# npm run dev / npm start generate a private RAIDROOM_ACTIVITY_SYNC_KEY in .env
# for the local background collector. Do not copy this local secret to the client.
