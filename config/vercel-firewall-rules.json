{
  "project": "coc",
  "scope": "lambo3",
  "rules": [
    {
      "name": "CoC public API - 60 per minute",
      "conditions": [
        {"type": "path", "op": "pre", "value": "/api/"},
        {"type": "path", "op": "pre", "value": "/api/players/", "neg": true}
      ],
      "requests": 60,
      "windowSeconds": 60,
      "keys": ["ip"],
      "action": "rate_limit"
    },
    {
      "name": "CoC player API - 15 per minute",
      "conditions": [{"type": "path", "op": "pre", "value": "/api/players/"}],
      "requests": 15,
      "windowSeconds": 60,
      "keys": ["ip"],
      "action": "rate_limit"
    }
  ]
}
